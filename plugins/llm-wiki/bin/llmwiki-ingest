#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["duckdb"]
# ///
"""llmwiki-ingest — duckdb CLI entrypoint (DEC-1=(b); bin/ shim).

The ingest area-entrypoint. It declares the `duckdb` runtime dep via PEP 723 so
the read path (dep-free `llmwiki`) is never coupled to duckdb's native install
(failure isolation, DEC-1(b)). T-layer bootstrap (single `sys.path` insert) so
`import llmwiki` resolves under path-import (no-install), then subordinates the
existing `ingest_driver` verb-CLI verbatim:

    ingest {begin|plan-fanout|finish|apply-finish|abort|enumerate|session-plan|project-batch|project-batch-cleanup} ...

The first token after the program name is the literal `ingest` verb-group; the
rest is the driver's own argv (begin <root> <source> ..., finish <root>
<outcome> ..., etc.), passed through unchanged so the driver's JSON/stderr
contract stays byte-equivalent.
"""
import os
import sys

# T-layer bootstrap: plugin root = parent of bin/. Single path-injection point.
_PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if _PLUGIN_ROOT not in sys.path:
    sys.path.insert(0, _PLUGIN_ROOT)

from llmwiki.ingest import ingest_driver

# Built from the driver's canonical verb tuple (single source of truth) — no
# literal re-listing here, so the drifted 7-verb banner can never recur.
_USAGE = ("usage: llmwiki-ingest ingest <"
          + "|".join(ingest_driver.INGEST_VERBS) + "> ...")

# Exit-code contract (theme1 i:39, generalized to this entrypoint 2026-07-16),
# byte-identical to cli.py's EX_USAGE. A verb-group mismatch here is a usage
# error, not a state sentinel.
EX_USAGE = 64


def main(argv: "list[str] | None" = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] != "ingest":
        # Targeted hint: the caller ran a real driver verb but dropped the
        # required `ingest` area-entrypoint group (e.g. `llmwiki-ingest begin
        # ...`). Sourced from INGEST_VERBS so EVERY verb fires — including
        # apply-finish and project-batch-cleanup, which the old drifted banner
        # omitted entirely.
        if argv and argv[0] in ingest_driver.INGEST_VERBS:
            print(f"did you mean: llmwiki-ingest ingest {argv[0]} ...? "
                  "(the `ingest` verb-group is required)", file=sys.stderr)
        print(_USAGE, file=sys.stderr)
        return EX_USAGE
    # Subordinate the existing verb-CLI: pass the driver its own argv verbatim.
    return ingest_driver.main(argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
