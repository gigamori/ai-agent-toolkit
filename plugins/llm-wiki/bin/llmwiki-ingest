#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["duckdb"]
# ///
"""llmwiki-ingest — duckdb CLI entrypoint (DEC-1=(b); bin/ shim).

The ingest area-entrypoint. It declares the `duckdb` runtime dep via PEP 723 so
the read path (dep-free `llmwiki`) is never coupled to duckdb's native install
(failure isolation, DEC-1(b)). T-layer bootstrap (single `sys.path` insert) so
`import llmwiki` resolves under path-import (no-install), then subordinates the
existing `ingest_driver` verb-CLI verbatim:

    ingest {begin|plan-fanout|finish|abort|enumerate|session-plan|project-batch} ...

The first token after the program name is the literal `ingest` verb-group; the
rest is the driver's own argv (begin <root> <source> ..., finish <root>
<outcome> ..., etc.), passed through unchanged so the driver's JSON/stderr
contract stays byte-equivalent.
"""
import os
import sys

# T-layer bootstrap: plugin root = parent of bin/. Single path-injection point.
_PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if _PLUGIN_ROOT not in sys.path:
    sys.path.insert(0, _PLUGIN_ROOT)

from llmwiki.ingest import ingest_driver

_USAGE = "usage: llmwiki-ingest ingest <begin|plan-fanout|finish|abort|enumerate|session-plan|project-batch> ..."


def main(argv: "list[str] | None" = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] != "ingest":
        print(_USAGE, file=sys.stderr)
        return 2
    # Subordinate the existing verb-CLI: pass the driver its own argv verbatim.
    return ingest_driver.main(argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
