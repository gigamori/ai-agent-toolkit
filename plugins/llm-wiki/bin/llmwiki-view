#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["markdown", "nh3"]
# ///
"""llmwiki-view — markdown CLI entrypoint (DEC-1=(b); bin/ shim).

The view area-entrypoint. It declares the `markdown` + `nh3` runtime deps via
PEP 723 (nh3 sanitizes untrusted page HTML, #21) so the read path (dep-free
`llmwiki`) is never coupled to them (failure isolation, DEC-1(b)). T-layer bootstrap (single `sys.path` insert) so
`import llmwiki` resolves under path-import (no-install), then subordinates the
existing `generate_wiki_view` argv-CLI verbatim:

    view --serve [--port N] [--no-open] [--root R]

The first token after the program name is the literal `view` verb; the rest is
the viewer's own argv, passed through unchanged so its stderr summary line and
flags stay byte-equivalent.
"""
import os
import sys

# T-layer bootstrap: plugin root = parent of bin/. Single path-injection point.
_PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if _PLUGIN_ROOT not in sys.path:
    sys.path.insert(0, _PLUGIN_ROOT)

from llmwiki.view import generate_wiki_view

_USAGE = "usage: llmwiki-view view --serve [--port N] [--no-open] [--root R]"

# Exit-code contract (theme1 i:39, generalized to this entrypoint 2026-07-16),
# byte-identical to cli.py's EX_USAGE. A verb mismatch here is a usage error,
# not a state sentinel.
EX_USAGE = 64


def main(argv: "list[str] | None" = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] != "view":
        print(_USAGE, file=sys.stderr)
        return EX_USAGE
    # Subordinate the existing argv-CLI: pass the viewer its own argv verbatim.
    return generate_wiki_view.main(argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
