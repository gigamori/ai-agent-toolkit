{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python ${CLAUDE_PLUGIN_ROOT}/hooks/notes_index_reminder.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python ${CLAUDE_PLUGIN_ROOT}/hooks/session_compact_reset.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python ${CLAUDE_PLUGIN_ROOT}/hooks/task_rebuild_progress.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python ${CLAUDE_PLUGIN_ROOT}/hooks/touched_capture.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python ${CLAUDE_PLUGIN_ROOT}/hooks/session_init.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python ${CLAUDE_PLUGIN_ROOT}/hooks/session_sync.py"
          },
          {
            "type": "command",
            "command": "uv run --no-project python ${CLAUDE_PLUGIN_ROOT}/hooks/session_progress_capture.py"
          }
        ]
      }
    ]
  }
}
