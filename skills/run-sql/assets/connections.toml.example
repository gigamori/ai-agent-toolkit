# run-sql connections template
# Copy to ~/.config/run-sql/connections.toml
# Or set RUN_SQL_CONFIG env var to a custom path
#
# Uncomment and edit the connections you need.

# --- PostgreSQL ---
# [connections.postgres]
# dsn = "postgresql+psycopg2://user:password@localhost:5432/dbname"
# description = "PostgreSQL (local)"

# --- MySQL ---
# [connections.mysql]
# dsn = "mysql+pymysql://user:password@localhost:3306/dbname"
# description = "MySQL (local)"

# --- MariaDB ---
# [connections.mariadb]
# dsn = "mariadb+mariadbconnector://user:password@localhost:3306/dbname"
# description = "MariaDB (local)"

# --- Amazon Redshift ---
# [connections.redshift]
# dsn = "redshift+redshift_connector://user:password@cluster.xxxx.region.redshift.amazonaws.com:5439/dbname"
# description = "Redshift"

# --- Snowflake ---
# [connections.snowflake]
# dsn = "snowflake://user:password@account/dbname/schema?warehouse=WH&role=ROLE"
# description = "Snowflake"

# --- Google BigQuery ---
# [connections.bigquery]
# dsn = "bigquery://project-id/dataset?credentials_path=/path/to/service-account-key.json"
# description = "BigQuery"
#
# Alternative: set GOOGLE_APPLICATION_CREDENTIALS env var instead of credentials_path
# dsn = "bigquery://project-id/dataset"
#
# Optional: set the dataset location (region) via the location query param, e.g. asia-northeast1, US, EU
# dsn = "bigquery://project-id/dataset?credentials_path=/path/to/service-account-key.json&location=asia-northeast1"

# --- DuckDB ---
# [connections.duckdb]
# dsn = "duckdb:///path/to/database.duckdb"
# description = "DuckDB (local file)"

# --- Databricks (SQL warehouse) ---
# [connections.databricks]
# dsn = "databricks://token:<ACCESS_TOKEN>@<SERVER_HOSTNAME>?http_path=<HTTP_PATH>&catalog=<CATALOG>&schema=<SCHEMA>"
# description = "Databricks SQL warehouse"
#
# - SERVER_HOSTNAME / HTTP_PATH: SQL Warehouse の Connection details タブから取得
#   (SQL warehouse の http_path は /sql/1.0/warehouses/<id> 形式)
# - 認証は Personal Access Token (PAT)。<ACCESS_TOKEN> は直書きせず安全に管理すること
# - SELECT は実行可。DML/UPDATE が確定するかは未検証 (残課題)
# - サーバ側クエリキャンセルは未実装 (local-only フォールバック・残課題)
