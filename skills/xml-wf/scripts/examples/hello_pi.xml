<!-- The pi-compatible counterpart of hello.xml, for the pi backend of
     `wfrun run` (pass the backend flag as pi).

     hello.xml uses schema= to force a structured integer out of s2_count and
     then branches on it with test=. The pi backend has no forced-structured-
     output flag and refuses schema= at startup, so this version moves the
     value into a file: the step writes it, expect-file= polices that it was
     written, and the branch asks about the file instead of comparing a number.

     That is a reduction, not a translation: schema= guaranteed the shape of
     the output, expect-file only guarantees the file exists. Keep hello.xml
     as the run-cc example; the pair is the point. See references/run-pi.md,
     "Replacing schema=".

     expect-file= appears twice here, not once: s2_count's is the schema=
     replacement above, but s1_write's is independent of it — hello.xml's
     s1_write never had schema= to begin with (it only ever trusted the
     model's own claim that it wrote the file), so that occurrence is not a
     rewrite of anything, just an added check available regardless of
     backend.

     "the current directory" in s2_count's and s3_note's task text is the
     step subprocess's own working directory: the directory wfrun launches
     that step's `pi`/`claude` child process in (== base_dir, this workflow
     file's own directory), set explicitly per step by the executor. Not the
     wfrun process's own OS-level cwd (pi-studio forbids relying on that),
     and not a pi "session" cwd field — there is no session here to have
     one, since every step is dispatched session-less (pi's no session flag). -->
<workflow name="hello_pi" version="2" max="10">
  <param name="topic" default="the sea"/>
  <rules id="style">Write concisely. The poem must be 3 lines or fewer.</rules>

  <step id="s1_write" role="writer" mode="execute" rules="style"
        output="poem_path" output-type="value" expect-file="output/poem.txt">
    <task>Write a short poem about {topic} and save it to the file output/poem.txt. Return only the relative path of the saved file as your final response.</task>
  </step>

  <step id="s2_count" role="writer" mode="execute" output="count_path"
        output-type="value" expect-file="output/line_count.txt">
    <task>Read the file {poem_path}, count its lines, and write ONLY that integer (no other text, no trailing prose) to the relative path output/line_count.txt under the current directory. Return only the relative path of the file you wrote as your final response.</task>
  </step>

  <if ask="Does the file {count_path} contain an integer of 1 or greater?">
    <then><set var="status" value="ok"/></then>
    <else><set var="status" value="empty"/></else>
  </if>

  <if ask="Does the content of file {poem_path} read as a poem?">
    <then>
      <step id="s3_note" mode="execute" tools="Write">
        <role>You are a careful file clerk. You write exactly what is requested — nothing more, nothing less — and you never editorialize.</role>
        <task>Write exactly APPROVED to the relative path ./output/note.txt under the current directory (do not convert it to an absolute path). Return only the file path as your final response.</task>
      </step>
    </then>
  </if>
</workflow>
